{
    "name": "sugiphp/captcha",
    "type": "library",
    "description": "SugiPHP CAPTCHA Component",
    "keywords": ["CAPTCHA"],
    "license": "MIT",
    "authors": [
        {
            "name": "Plamen Popov",
            "email": "tzappa@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0",
        "psr/cache": "^1.0 || ^2.0 || ^3.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "suggest": {
        "psr/cache": "To keep the used CAPTCHA codes in a PSR-6 cache pool (CacheUsedKeys)",
        "psr/simple-cache": "To keep the used CAPTCHA codes in a PSR-16 cache (SimpleCacheUsedKeys)",
        "ext-pdo": "To keep the used CAPTCHA codes in a database (PdoUsedKeys)"
    },
    "autoload": {
        "psr-4": {
            "SugiPHP\\Captcha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugiPHP\\Captcha\\Tests\\": "tests/"
        }
    }
}
